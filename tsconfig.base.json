{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@myrss/core": ["packages/core/src/index.ts"],
      "@myrss/config": ["packages/config/src/index.ts"],
      "@myrss/db": ["packages/db/src/index.ts"],
      "@myrss/shared": ["packages/shared/src/index.ts"],
      "@myrss/shared/*": ["packages/shared/src/*"]
    }
  }
}
