{
  "name": "myrss",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:web": "pnpm --filter @myrss/web dev",
    "dev:server": "pnpm --filter @myrss/server dev",
    "dev:worker": "pnpm --filter @myrss/server dev:worker",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" build",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @myrss/db prisma:generate",
    "db:migrate": "pnpm --filter @myrss/db prisma:migrate",
    "db:seed": "pnpm --filter @myrss/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.34.1",
    "typescript": "^5.8.3"
  }
}
