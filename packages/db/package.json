{
  "name": "@myrss/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "seed": "node prisma/seed.mjs",
    "prisma:generate": "node scripts/run-prisma.mjs generate --schema prisma/schema.prisma",
    "prisma:migrate": "node scripts/init-sqlite.mjs"
  },
  "dependencies": {
    "@myrss/shared": "workspace:*",
    "@prisma/client": "^6.11.1"
  },
  "devDependencies": {
    "prisma": "^6.11.1",
    "typescript": "^5.8.3"
  }
}
